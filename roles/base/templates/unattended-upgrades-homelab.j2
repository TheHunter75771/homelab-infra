// {{ ansible_managed }}
// Security updates only, no automatic reboot (docs/CONTRACTS.md §7).
// Read after 20auto-upgrades and 50unattended-upgrades, so the values here win.

APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";

// Replace (not extend) the origin lists from earlier files. The release pocket stays because
// it never changes after release and security fixes can need a dependency from it; -updates,
// -proposed, -backports and third-party repositories (Docker, Tailscale) are never installed.
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Allowed-Origins {
	"${distro_id}:${distro_codename}";
	"${distro_id}:${distro_codename}-security";
	"${distro_id}ESMApps:${distro_codename}-apps-security";
	"${distro_id}ESM:${distro_codename}-infra-security";
};

// Reboots are manual: the dashboard shows when one is needed and Noah picks the time.
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Automatic-Reboot-WithUsers "false";
