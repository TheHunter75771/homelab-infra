# {{ ansible_managed }}
# Host hardening (2026-10-24 audit). rp_filter stays at Ubuntu's 2 (loose), which Tailscale needs.

# No ICMP redirects: the box routes for nobody. Docker forwards between its bridges and the LAN
# (never back out the interface a packet came in on), and Tailscale isn't a subnet router or exit
# node here. The kernel ORs "all" with each interface's own value, so the glob also clears the
# interfaces that already exist; systemd's udev rule applies it to interfaces created later
# (Docker bridges and veths).
net.ipv4.conf.*.send_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0

# Log packets with impossible source addresses. With loose rp_filter and a default route, Docker
# (172.16.0.0/12) and tailnet (100.64.0.0/10) sources are routable, so they don't count. Only truly
# bogus sources (multicast, broadcast, loopback or 0.0.0.0 off-link) are logged, and the kernel
# rate-limits these messages (net.core.message_burst 10, message_cost 5 s).
net.ipv4.conf.all.log_martians = 1
net.ipv4.conf.default.log_martians = 1

# No core dumps from setuid programs (apport set 2; it's masked now and kdump is gone).
fs.suid_dumpable = 0

# Kernel and BPF hardening (2026-10-25 Lynis run).
# O_CREAT on a FIFO in a sticky world-writable directory fails unless the opener owns it
# (Ubuntu ships 1, which covers only the world-writable case).
fs.protected_fifos = 2
# Kernel pointers are hidden even from root (only perf/bpftrace symbolisation would miss them).
kernel.kptr_restrict = 2
# Constant blinding for every BPF JIT program, root's included (systemd's and Docker's cgroup
# programs only lose a little speed).
net.core.bpf_jit_harden = 2
# Unprivileged BPF off and locked until reboot (2 is "off but re-enableable"). dockerd runs as
# root, not rootless, so it doesn't need unprivileged BPF. Re-applying 1 is allowed; any other value isn't.
kernel.unprivileged_bpf_disabled = 1

# Deliberately NOT set, because they would break this box:
# - kernel.modules_disabled = 1: the boot gate's USB repair and the iTCO_wdt loader load modules
#   after boot.
# - net.ipv4.conf.all.forwarding = 0: Docker forwards container traffic.
# - net.ipv4.conf.*.rp_filter = 1: Tailscale needs loose mode (Ubuntu's 2 stays).
# - kernel.sysrq = 0: Ubuntu's 176 stays as the emergency keyboard path, since the hardware
#   watchdog doesn't reset this HP.
