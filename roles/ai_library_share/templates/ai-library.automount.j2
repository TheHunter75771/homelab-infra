# {{ ansible_managed }}
# Role ai_library_share (docs/CONTRACTS.md §12.17.3): x-systemd.automount + x-systemd.idle-timeout=0.
[Unit]
Description=Automount the AI Library share

[Automount]
Where={{ ai_library_share_mount_point }}
TimeoutIdleSec=0
DirectoryMode=0755

[Install]
WantedBy=remote-fs.target
