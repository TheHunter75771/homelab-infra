#!/usr/bin/env bash
# Fake nsenter: only `--net=/proc/<pid>/ns/net -- <command...>`. Records its arguments in
# $FA_TEST_DIR/nsenter.args and runs the command with FA_NETNS=1 (the fake curl answers as open-webui's netns).
set -euo pipefail
: "${FA_TEST_DIR:?}"
printf '%s\n' "$@" >"$FA_TEST_DIR/nsenter.args"
[[ "$1" =~ ^--net=/proc/[1-9][0-9]*/ns/net$ ]] && [ "$2" = -- ] || { echo "fake nsenter: unexpected arguments: $*" >&2; exit 2; }
shift 2
FA_NETNS=1 exec "$@"
