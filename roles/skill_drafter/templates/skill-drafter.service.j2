# {{ ansible_managed }}
# Skill Forge drafter K2 (docs/CONTRACTS.md §12.19.1, deploy module H6): polls the AI Library's 35-forge/ and,
# for a request with ingested sources (or Noah's `decision: revise` plus notes), asks the local model through the
# broker for a SKILL.md and files it with forge.draft_skill. It never decides, ticks or edits review.md. User
# sdraft (supplementary group rgate for the library mount, never docker), no capabilities, writes only 35-forge.
# Installed always, enabled only with skill_drafter_enabled (the library share must be mounted: RequiresMountsFor
# + the sentinel assert).
[Unit]
Description=Skill Forge drafter (drafts SKILL.md cards for Noah's review)
Documentation=file://{{ skill_drafter_launcher }}
After=network-online.target
Wants=network-online.target
RequiresMountsFor={{ skill_drafter_library_root }}
# §12.11 mount safety: never run against an empty mount point.
AssertPathExists={{ skill_drafter_sentinel }}
AssertPathIsDirectory={{ skill_drafter_forge_dir }}

[Service]
Type=exec
# K2's launcher under -I (no PYTHON* variables, no user site, no working directory on sys.path): it puts its own
# root-owned directory, which holds skill_drafter, forge and library, first on sys.path. -B: no bytecode there.
ExecStart={{ (skill_drafter_argv + ['serve']) | join(' ') }}
Restart=on-failure
RestartSec={{ skill_drafter_restart_sec }}
SyslogIdentifier=skill-drafter
# The sandbox: exactly vars/main.yml skill_drafter_sandbox (the post-start status check uses the same list).
# - AI_LIBRARY_CAP: the library's size cap as the library CLI reads it; forge.draft_skill files nothing past it.
# - ReadWritePaths is 35-forge only: drafter-log.md, and through forge.draft_skill skill/, review.md, state.md,
#   previous/<n>/, the forge lock and the library's temp files. draft_skill never rebuilds INDEX.md. The rest of
#   the library (10-sources/, the texts it drafts from; the whole root, walked for the cap) stays read-only.
# - PrivateTmp: K2 writes the validated draft to a temp dir before draft_skill copies it in.
# - RestrictAddressFamilies has no AF_INET6: the broker URL is an IPv4 literal.
# - /run read-only explicitly (found writable despite ProtectSystem=strict on the mediaserver, 2026-10-24).
# - No ProcSubset=pid (Reviewer E, §12.17: it hides /proc/self/net); ProtectProc=invisible stays.
# - IP filter (systemd checks the destination of outgoing packets and the source of incoming ones; an allow
#   entry wins over a deny entry). The broker only:
#   - {{ tailnet_ip | default('') }}/32 and the container range{{ 's' if skill_drafter_broker_ranges | length > 1 else '' }}: the broker is published on ai-box's tailnet address,
#     Docker DNATs the request to the broker container (the egress filter sees that address) and the reply
#     comes back from the tailnet address (the ingress filter sees that). SearXNG's subnet is cut out of the
#     range: it would forward queries to the internet;
#   - {{ skill_drafter_dns_stub }}/32: systemd-resolved's stub;
#   - everything else is denied (IPAddressDeny=any).
{% for p in skill_drafter_sandbox %}
{{ p }}
{% endfor %}

[Install]
WantedBy=multi-user.target
