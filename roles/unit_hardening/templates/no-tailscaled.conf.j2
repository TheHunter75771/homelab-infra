# {{ ansible_managed }}
# Role unit_hardening (docs/CONTRACTS.md §12.30, H15; Reviewer Q, Q2-1): hide tailscaled's local API from this unit.
# Any process that can open /run/tailscale/tailscaled.sock can have tailscaled dial tailnet peers as root, which
# walks past this unit's IPAddressDeny/IPAddressAllow (the connection is tailscaled's, not the unit's).
# tailscaled.service keeps the directory for the whole boot (RuntimeDirectoryPreserve=yes) and tmpfiles.d creates
# it at boot, so the hidden mount is never detached by a tailscaled restart.
[Service]
InaccessiblePaths={{ unit_hardening_hidden_paths | join(' ') }}
{% if uh_root %}
# Root unit (Reviewer Q, Q6-1): its own PID namespace, so /proc shows only its processes and it can't reach the
# socket through /proc/<pid>/root of a root process outside (PID 1 included). It runs as PID 1 there: a signal
# with no handler (SIGTERM for Python) is ignored, so a stop waits for SIGKILL after TimeoutStopSec.
PrivatePIDs=yes
# Root unit (Reviewer Q, Q8-1): /run is an empty read-only tmpfs, so neither tailscaled nor anything else under /run
# that hands out root (D-Bus StartTransientUnit, docker/containerd/podman/libvirt, systemd's varlink sockets) is
# there. Only its allowlist is bound in, read-only{{ ':' if uh_run_allow else ' (nothing).' }}
{% if unit_hardening_bus_socket in uh_run_allow %}
# The system bus is bound in: StartTransientUnit stays possible, so this unit's hiding is ADVISORY (root + system bus).
{% endif %}
TemporaryFileSystem=/run:ro
{% if uh_run_allow %}
BindReadOnlyPaths={{ uh_run_allow | join(' ') }}
{% endif %}
{% endif %}
{% if uh_via_bus %}
# systemctl over the D-Bus system bus: /run/systemd/private refuses a peer in a child PID namespace (ENODATA).
Environment=SYSTEMCTL_FORCE_BUS=1
{% endif %}
