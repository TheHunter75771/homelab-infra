# {{ ansible_managed }}
# OnFailure= of {{ calendar_service }}: it gave up after 5 failed starts in 10 minutes.
# The marker tells {{ calendar_recovered_service }} (queued by every start of the calendar) to
# push "Calendar back up" on the next good start, which closes this alert on the dashboard.
# It's written first, so a push that fails still leaves it.
[Unit]
Description=Push an alert when the household calendar is down
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
StateDirectory={{ calendar_alert_state_name }}
ExecStart=/usr/bin/touch {{ calendar_alert_marker }}
ExecStart={{ calendar_notify_bin }} --tag calendar --title "Calendar is down" --body "homelab-calendar.service failed. See: journalctl -u homelab-calendar"
# 2 = no subscribed devices yet; nothing to deliver is not a failure of this unit.
SuccessExitStatus=2
SyslogIdentifier=homelab-calendar-alert
