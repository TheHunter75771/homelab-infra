{
  "name": "homelab-dashboard-server",
  "version": "2.0.0",
  "private": true,
  "description": "Dashboard v2 server: homelab health API, Docker actions via the root helper, and Web Push (absorbs push-core)",
  "license": "MIT",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-reporter=spec 'test/*.test.js'",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' 'test/*.test.js'",
    "test:time-travel": "node test/tools/time-travel.mjs"
  },
  "dependencies": {
    "web-push": "3.6.7"
  }
}
