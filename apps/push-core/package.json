{
  "name": "homelab-push-core",
  "version": "0.1.0",
  "private": true,
  "description": "Web Push subscription service and PWA for homelab alerts",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-reporter=spec 'test/*.test.js'",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' 'test/*.test.js'",
    "icons": "node scripts/gen-icons.js public/icons"
  },
  "dependencies": {
    "web-push": "3.6.7"
  }
}
