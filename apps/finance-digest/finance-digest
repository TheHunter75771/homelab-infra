#!/usr/bin/python3
"""Launcher that works under `python3 -I`: adds its own directory (where finance_digest and library
are installed side by side) and, in a repo checkout, ../skill-library."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, here)
if not os.path.isdir(os.path.join(here, "library")):
    sys.path.insert(1, os.path.join(os.path.dirname(here), "skill-library"))

from finance_digest.__main__ import main  # noqa: E402

sys.exit(main())
